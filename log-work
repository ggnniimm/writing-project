#!/bin/bash
# Script to add manual entry to git_diary.md using update_diary.py

if [ -z "$1" ]; then
    echo "📢 กรุณาระบุหัวข้อบันทีก:"
    read -r TITLE
else
    TITLE="$1"
fi

if [ -z "$2" ]; then
    DETAILS=""
else
    DETAILS="$2"
fi

echo "🤔 งานนี้อยู่ในหมวดไหนครับ?"
echo "   1) ✍️  Content & Research (งานเนื้อหา/ค้นคว้า)"
echo "   2) 🔧 System & Workflow (งานระบบ/ตั้งค่า)"
read -p "เลือก (1/2): " CAT_CHOICE

CATEGORY="system"
if [ "$CAT_CHOICE" == "1" ]; then
    CATEGORY="content"
fi

python3 scripts/update_diary.py "$CATEGORY" "$TITLE" "$DETAILS"
