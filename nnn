#!/bin/bash

echo "---------------------------------------------------"
echo "🤖 Ending Day Routine (nnn)..."
echo "---------------------------------------------------"

# 0. Stage All Changes first (so Auto-Log can see them)
echo "📦 0. Staging all changes..."
git add .

# 1. Auto-Log Staged Changes (Operations Log)
echo "📝 1. Auto-logging staged changes..."
python3 scripts/update_diary.py --auto-log

# 2. Generate Summary
echo "📊 2. Summarizing today's achievements (w/ AI Retrospective)..."
python3 scripts/update_diary.py --summary

# 3. Push Work
echo "🚀 3. Syncing to Remote..."

# Generate HTML (parity with ppp)
echo "🎨 กำลังสร้างเอกสาร HTML ระดับพรีเมียม (Smart Build)..."
python3 scripts/generate_html.py

# Final Stage (Capture Diary & HTML updates)
git add .
git commit -m "End of Day Sync 💤" || echo "Nothing to commit"
git push

echo "---------------------------------------------------"
echo "✅ Day ended successfully! See you tomorrow."
echo "---------------------------------------------------"
