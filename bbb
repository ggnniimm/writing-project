#!/bin/bash

echo "🚀 Starting Day... (คำสั่ง bbb)"
echo "---------------------------------------------------"

# 1. Pull latest changes
# Check for local changes
if [[ -n $(git status -s) ]]; then
  echo "⚠️  Found local changes. Attempting to stash..."
  git stash
  STASHED=1
fi

# 1. Pull latest changes
echo "📥 Git Pulling..."
if ! git pull; then
    echo "❌ Git Pull Failed! Please check your network or git status."
    if [[ "$STASHED" == "1" ]]; then
        echo "🔄 Restoring local changes..."
        git stash pop
    fi
    exit 1
fi

if [[ "$STASHED" == "1" ]]; then
    echo "📤 Restoring local changes..."
    git stash pop
fi

echo "---------------------------------------------------"
# 2. Read README (Highlights)
echo "📚 Project Guidelines (README)"
# Show only the AI Agent Guidelines and Workflow Commands sections (approx lines 1-25)
head -n 25 README.md
echo "..."
echo "(Read full README.md if needed)"

echo "---------------------------------------------------"
echo "📅 Initializing Diary for Today..."
python3 update_diary.py --start-day
python3 update_diary.py --read-latest

echo "---------------------------------------------------"
echo "💡 Ready to start! Use 'ppp' to sync your work."
echo "✅ Job Init Complete."
